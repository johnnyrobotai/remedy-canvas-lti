# ============================================================
# Remedy Canvas LTI Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# App
ENVIRONMENT=development
AUTH_BYPASS_FOR_LOCAL=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8001
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
APP_BASE_URL=http://localhost:8001
SESSION_SECRET_KEY=dev-secret-change-me-in-production
DATABASE_URL=
POSTGRES_DB=canvas_remedy_lti
POSTGRES_USER=remedy
POSTGRES_PASSWORD=
DOCHUB_REQUIRES_AUTH=true
DOCHUB_MAX_UPLOAD_BYTES=50000000
CANVAS_WEBHOOK_SECRET=

# AI (optional for local dev; production normally uses Ollama Cloud)
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=kimi-k2.6:cloud

# LTI / Canvas OAuth2 (needed for Canvas integration)
LTI_TOOL_PRIVATE_KEY_PEM=
LTI_TOOL_PRIVATE_KEY_PEM_FILE=
CANVAS_OAUTH2_CLIENT_ID=
CANVAS_OAUTH2_CLIENT_SECRET=

# Local Canvas dev
LOCAL_CANVAS_BASE_URL=http://canvas.docker
LOCAL_CANVAS_CLIENT_ID=10000000000002
LOCAL_CANVAS_DEPLOYMENT_ID=
LOCAL_CANVAS_API_TOKEN=
